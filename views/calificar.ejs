<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kairos Express - Califica tu Servicio</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fuente corporativa Instrument Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;650;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0b0b0b;
            --paper: #0f0e0c;
            --yellow: #ffcc00;
            --yellow-dark: #e0b300;
        }

        body {
            background-color: var(--paper);
            color: #fbfbf9;
            font-family: 'Instrument Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% -12%, rgba(255, 204, 0, 0.15), transparent 35%),
                linear-gradient(180deg, #12100b 0%, #080808 100%);
            padding: 40px 0;
        }

        .card-custom {
            background-color: #141414;
            border: 1px solid rgba(255, 204, 0, 0.2);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
        }

        .card-custom::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--yellow), transparent);
        }

        .btn-custom {
            background-color: var(--yellow);
            color: var(--ink);
            font-weight: 700;
            border: none;
            border-radius: 999px;
            padding: 14px;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 20px rgba(255, 204, 0, 0.3);
        }

        .btn-custom:hover {
            background-color: #ffd633;
            color: var(--ink);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(255, 204, 0, 0.45);
        }

        .text-accent {
            color: var(--yellow);
        }

        .form-label {
            color: #e0e0dc !important;
            font-weight: 650;
            font-size: 0.92rem;
        }

        .form-control, .form-select {
            background-color: #1c1c1c !important;
            border: 1.5px solid #333 !important;
            color: #fff !important;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--yellow) !important;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.2) !important;
            background-color: #222 !important;
            color: #fff !important;
        }

        .form-control::placeholder {
            color: #666;
        }

        .btn-back-home {
            background-color: transparent;
            color: #b0b0a8;
            font-weight: 650;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 999px;
            padding: 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            width: 100%;
            margin-top: 10px;
        }

        .btn-back-home:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #fff;
            border-color: rgba(255, 204, 0, 0.4);
        }
    </style>
</head>
<body>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-accent mb-1">⭐ Califica tu Experiencia</h2>
                    <p class="text-muted small text-uppercase tracking-wider">Kairos Express Valora tu Opinión</p>
                </div>
                
                <form action="/process-rating" method="POST">
                    <div class="mb-3">
                        <label for="service_code" class="form-label">Código de Seguimiento o Servicio</label>
                        <input type="text" class="form-control" id="service_code" name="service_code" required placeholder="Ej. TECH-ZGG4K o KAI-38N0V">
                    </div>

                    <div class="mb-3">
                        <label for="rating" class="form-label">Calificación (Estrellas)</label>
                        <select class="form-select text-warning fw-bold" id="rating" name="rating" required>
                            <option value="5">⭐⭐⭐⭐⭐ Excelente (5 Estrellas)</option>
                            <option value="4">⭐⭐⭐⭐ Muy Bueno (4 Estrellas)</option>
                            <option value="3">⭐⭐⭐ Regular (3 Estrellas)</option>
                            <option value="2">⭐⭐ Malo (2 Estrellas)</option>
                            <option value="1">⭐ Pésimo (1 Estrella)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="feedback" class="form-label">Comentarios o Sugerencias</label>
                        <textarea class="form-control" id="feedback" name="feedback" rows="3" placeholder="Cuéntanos cómo fue la atención del técnico o mensajero..."></textarea>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-custom btn-lg">Enviar Calificación</button>
                        <a href="/" class="btn-back-home">
                            <span>←</span> Volver al Inicio
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

</body>
</html>