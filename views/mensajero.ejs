<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kairos Express - Portal de Mensajería</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fuente corporativa Instrument Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;650;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0b0b0b;
            --paper: #0f0e0c;
            --yellow: #ffcc00;
            --yellow-dark: #e0b300;
        }

        body {
            background-color: var(--paper);
            color: #fbfbf9;
            font-family: 'Instrument Sans', sans-serif;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 50% -12%, rgba(255, 204, 0, 0.12), transparent 35%),
                linear-gradient(180deg, #12100b 0%, #080808 100%);
        }

        .card-custom {
            background-color: #141414;
            border: 1px solid rgba(255, 204, 0, 0.2);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.7);
        }

        .text-accent {
            color: var(--yellow);
        }

        .table-dark {
            background-color: #141414 !important;
            color: #e0e0dc !important;
        }

        .table-dark th {
            border-color: #333 !important;
            color: var(--yellow) !important;
        }

        .table-dark td {
            border-color: #222 !important;
        }

        .btn-outline-warning {
            color: var(--yellow);
            border-color: var(--yellow);
            border-radius: 999px;
            padding: 6px 16px;
            font-weight: 600;
        }

        .btn-outline-warning:hover {
            background-color: var(--yellow);
            color: var(--ink);
        }

        .badge.bg-info {
            background-color: rgba(255, 204, 0, 0.15) !important;
            color: var(--yellow) !important;
            border: 1px solid rgba(255, 204, 0, 0.3);
        }
    </style>
</head>
<body>

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="text-accent fw-bold">🏍️ Kairos Express - Ruta de Mensajeros</h1>
            <p class="text-muted">Panel exclusivo para motomensajeros en Cali y Valle del Cauca.</p>
            <a href="/" class="btn btn-outline-warning btn-sm">← Volver al Inicio</a>
        </div>
    </div>

    <div class="card card-custom p-4 mb-4">
        <h3 class="mb-3 text-warning fw-bold fs-5">📦 Envíos Asignados y Pendientes de Ruta</h3>
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Guía</th>
                        <th>Destinatario</th>
                        <th>Dirección</th>
                        <th>Distancia</th>
                        <th>Total Cobro</th>
                        <th>Estado Actual</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (shipments.length > 0) { %>
                        <% shipments.forEach(item => { %>
                            <tr>
                                <td class="fw-bold text-warning"><%= item.tracking_number %></td>
                                <td><%= item.recipient_name %></td>
                                <td><%= item.recipient_address %></td>
                                <td><%= item.distance_km %> km</td>
                                <td>$<%= Number(item.total_cost).toLocaleString() %> COP</td>
                                <td><span class="badge bg-info"><%= item.status %></span></td>
                                <td>
                                    <form action="/update-shipment-status" method="POST" class="d-inline">
                                        <input type="hidden" name="shipment_id" value="<%= item.id %>">
                                        <button type="submit" class="btn btn-sm btn-success fw-bold px-3 py-1 rounded-pill">Marcar Entregado</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay envíos pendientes de entrega en este momento.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

</body>
</html>