<script>
    // Función simple para alternar entre las pestañas de Usuarios y Aliados
    function switchTab(evt, tabName) {
        const contents = document.querySelectorAll('.beneficios-tab-content');
        contents.forEach(content => content.classList.remove('active-content'));

        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach(btn => btn.classList.remove('active'));

        document.getElementById(tabName).classList.add('active-content');
        evt.currentTarget.classList.add('active');
    }
</script>
        <!-- FOOTER PARCIAL -->
        <%- include('partials/footer') %>
    </main>

    <!-- SCRIPT DE INTERACTIVIDAD Y ANIMACIONES -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                document.getElementById('top').classList.add('is-ready');
            }, 50);

            const mosaicSection = document.getElementById('mosaic');
            
            if (mosaicSection) {
                const observer = new IntersectionObserver(([entry]) => {
                    if (entry.isIntersecting) {
                        mosaicSection.classList.add('grid-ready');
                    }
                }, { threshold: 0.15 });

                observer.observe(mosaicSection);
            }
        });
    </script>
