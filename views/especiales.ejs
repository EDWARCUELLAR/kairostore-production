<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kairos Express - Vueltas Especiales y Notariales</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fuente corporativa Instrument Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;650;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0b0b0b;
            --paper: #0f0e0c;
            --yellow: #ffcc00;
            --yellow-dark: #e0b300;
        }

        body {
            background-color: var(--paper);
            color: #fbfbf9;
            font-family: 'Instrument Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% -12%, rgba(255, 204, 0, 0.15), transparent 35%),
                linear-gradient(180deg, #12100b 0%, #080808 100%);
        }

        .card-custom {
            background-color: #141414;
            border: 1px solid rgba(255, 204, 0, 0.2);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
        }

        .card-custom::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--yellow), transparent);
        }

        .btn-custom {
            background-color: var(--yellow);
            color: var(--ink);
            font-weight: 700;
            border: none;
            border-radius: 999px;
            padding: 14px;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 20px rgba(255, 204, 0, 0.3);
        }

        .btn-custom:hover {
            background-color: #ffd633;
            color: var(--ink);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(255, 204, 0, 0.45);
        }

        .text-accent {
            color: var(--yellow);
        }

        .form-label {
            color: #e0e0dc !important;
            font-weight: 650;
            font-size: 0.92rem;
        }

        .form-text {
            color: #9e9e99 !important;
        }

        .form-control, .form-select {
            background-color: #1c1c1c !important;
            border: 1.5px solid #333 !important;
            color: #fff !important;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--yellow) !important;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.2) !important;
            background-color: #222 !important;
            color: #fff !important;
        }

        .form-control::placeholder {
            color: #666;
        }

        .tarifa-box {
            background: rgba(255, 204, 0, 0.05);
            border: 2px dashed rgba(255, 204, 0, 0.4);
            border-radius: 14px;
            padding: 18px;
        }
    </style>
</head>
<body>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-7">
            <div class="card card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-accent mb-1">🏛️ Kairos.express VIP</h2>
                    <p class="text-muted small text-uppercase tracking-wider">Vueltas Especiales y Notariales</p>
                </div>
                
                <form action="/process-special-errand" method="POST">
                    <div class="mb-3">
                        <label for="client_name" class="form-label">Nombre del Solicitante</label>
                        <input type="text" class="form-control" id="client_name" name="client_name" required placeholder="Ej. Dr. Eduardo Cuéllar">
                    </div>

                    <div class="mb-3">
                        <label for="client_phone" class="form-label">Teléfono de Contacto / WhatsApp</label>
                        <input type="tel" class="form-control" id="client_phone" name="client_phone" required placeholder="Ej. 3101234567">
                    </div>

                    <div class="mb-3">
                        <label for="errand_type" class="form-label">Tipo de Diligencia / Trámite</label>
                        <select class="form-select" id="errand_type" name="errand_type" required>
                            <option value="notaria">Trámite Notarial (Firmas, autenticaciones, escrituras)</option>
                            <option value="banco">Gestión Bancaria / Fila prioritaria</option>
                            <option value="legal">Radicación de documentos legales / judiciales</option>
                            <option value="custodia">Compra confidencial y custodia de valores</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Instrucciones Detalladas del Trámite</label>
                        <textarea class="form-control" id="description" name="description" rows="3" required placeholder="Ej. Recoger chequera en Notaría 2da del centro y radicar copia firmada en la oficina de la calle 5."></textarea>
                    </div>

                    <!-- Selector de Programación VIP -->
                    <div class="row mb-3">
                        <div class="col-md-6 mb-2">
                            <label for="tipo_programacion" class="form-label">Modalidad del Servicio</label>
                            <select class="form-select" id="tipo_programacion" name="tipo_programacion" onchange="toggleAgendaEspecial(this.value)">
                                <option value="inmediato">⚡ Gestión Prioritaria (Lo antes posible)</option>
                                <option value="programado">📅 Agendar Fecha y Hora</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-2" id="campo_fecha_especial" style="display: none;">
                            <label for="scheduled_at" class="form-label">Fecha y Hora de la Diligencia</label>
                            <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at">
                        </div>
                    </div>

                    <div class="row tarifa-box align-items-center my-3 mx-0">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label for="estimated_hours" class="form-label">Tiempo Estimado (Horas)</label>
                            <input type="number" step="0.5" class="form-control fw-bold bg-dark text-warning" id="estimated_hours" name="estimated_hours" value="1.0" min="0.5" required>
                            <div class="form-text small mt-1">Tarifa base de gestión + espera.</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label for="estimated_cost_display" class="form-label">Costo Estimado VIP</label>
                            <input type="text" class="form-control fw-bold border-0 bg-transparent p-0 fs-4 text-warning" id="estimated_cost_display" readonly value="$25,000 COP">
                            <!-- Campo oculto -->
                            <input type="hidden" id="estimated_cost" name="estimated_cost" value="25000">
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-custom btn-lg">Solicitar Vuelta Especial VIP</button>
                    </div>
                </form>
            </div>
            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none text-warning fw-semibold">← Volver al Inicio</a>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAgendaEspecial(valor) {
        const campoFecha = document.getElementById('campo_fecha_especial');
        if (valor === 'programado') {
            campoFecha.style.display = 'block';
            document.getElementById('scheduled_at').required = true;
        } else {
            campoFecha.style.display = 'none';
            document.getElementById('scheduled_at').required = false;
        }
    }

    // Lógica de cálculo de tarifas
    const hoursInput = document.getElementById('estimated_hours');
    const costDisplay = document.getElementById('estimated_cost_display');
    const costHidden = document.getElementById('estimated_cost');

    hoursInput.addEventListener('input', function() {
        const hours = parseFloat(this.value) || 0;
        const baseFee = 15000;
        const hourlyRate = 10000;
        const total = baseFee + (hours * hourlyRate);

        costDisplay.value = '$' + Math.round(total).toLocaleString() + ' COP';
        costHidden.value = Math.round(total);
    });
</script>

</body>
</html>