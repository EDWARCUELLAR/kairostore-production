<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kairos Express - Registro y Alianzas</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Fuente corporativa Instrument Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;650;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0b0b0b;
            --paper: #0f0e0c;
            --yellow: #ffcc00;
            --yellow-dark: #e0b300;
        }

        body {
            background-color: var(--paper);
            color: #fbfbf9;
            font-family: 'Instrument Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% -12%, rgba(255, 204, 0, 0.15), transparent 35%),
                linear-gradient(180deg, #12100b 0%, #080808 100%);
            padding: 40px 0;
        }

        .card-custom {
            background-color: #141414;
            border: 1px solid rgba(255, 204, 0, 0.2);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
        }

        .card-custom::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--yellow), transparent);
        }

        .btn-custom {
            background-color: var(--yellow);
            color: var(--ink);
            font-weight: 700;
            border: none;
            border-radius: 999px;
            padding: 14px;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 20px rgba(255, 204, 0, 0.3);
        }

        .btn-custom:hover {
            background-color: #ffd633;
            color: var(--ink);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(255, 204, 0, 0.45);
        }

        /* Botón de retroceso al inicio */
        .btn-back-home {
            background-color: transparent;
            color: #b0b0a8;
            font-weight: 650;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 999px;
            padding: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-back-home:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #fff;
            border-color: rgba(255, 204, 0, 0.4);
            transform: translateY(-2px);
        }

        .text-accent {
            color: var(--yellow);
        }

        .form-label {
            color: #e0e0dc !important;
            font-weight: 650;
            font-size: 0.92rem;
        }

        .form-text {
            color: #9e9e99 !important;
        }

        .form-control, .form-select {
            background-color: #1c1c1c !important;
            border: 1.5px solid #333 !important;
            color: #fff !important;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--yellow) !important;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.2) !important;
            background-color: #222 !important;
            color: #fff !important;
        }

        .form-control::placeholder {
            color: #666;
        }
    </style>
</head>
<body>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-7">
            <div class="card card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-accent mb-1">📝 Registro en Kairos.express</h2>
                    <p class="text-muted small text-uppercase tracking-wider">Crea tu cuenta de usuario o postúlate como aliado</p>
                </div>
                
                <form action="/register" method="POST">
                    <div class="mb-3">
                        <label for="name" class="form-label">Nombre Completo</label>
                        <input type="text" class="form-control" id="name" name="name" required placeholder="Ej. Carlos Mario Gómez">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Correo Electrónico</label>
                        <input type="email" class="form-control" id="email" name="email" required placeholder="correo@ejemplo.com">
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">Teléfono / WhatsApp de Contacto</label>
                        <input type="tel" class="form-control" id="phone" name="phone" required placeholder="Ej. 3101234567">
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña Segura</label>
                        <input type="password" class="form-control" id="password" name="password" required placeholder="••••••••">
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label">Selecciona tu Rol</label>
                        <select class="form-select" id="role" name="role" required onchange="toggleSoportes(this.value)">
                            <option value="client">👤 Cliente (Quiero pedir envíos o servicios)</option>
                            <option value="driver">🏍️ Mensajero (Quiero rodar y hacer entregas)</option>
                            <option value="technician">🔧 Técnico Especializado (Neveras, PCs, Electrodomésticos)</option>
                        </select>
                    </div>

                    <!-- Campo dinámico para soportes si es Mensajero o Técnico -->
                    <div class="mb-3" id="campo_soportes" style="display: none;">
                        <label for="soportes_info" class="form-label">Soportes, Títulos (SENA / Instituto) o Antecedentes</label>
                        <textarea class="form-control" id="soportes_info" name="soportes_info" rows="3" placeholder="Indica el enlace de tus certificados, número de diploma del SENA o referencias laborales..."></textarea>
                        <div class="form-text small mt-1">Tu cuenta quedará en estado <strong>Pendiente de Aprobación</strong> hasta que el administrador verifique tus datos.</div>
                    </div>

                    <script>
                        function toggleSoportes(rol) {
                            const campoSoportes = document.getElementById('campo_soportes');
                            if (rol === 'driver' || rol === 'technician') {
                                campoSoportes.style.display = 'block';
                                document.getElementById('soportes_info').required = true;
                            } else {
                                campoSoportes.style.display = 'none';
                                document.getElementById('soportes_info').required = false;
                            }
                        }
                    </script>

                    <!-- Botones de Acción y Retorno -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-custom btn-lg">Completar Registro</button>
                        <a href="/" class="btn btn-back-home">
                            <span>←</span> Volver al Inicio
                        </a>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a href="/login" class="text-decoration-none text-warning fw-semibold">¿Ya tienes cuenta? Inicia Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>